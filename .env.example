# --- Backend ---
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=
REDIS_URL=
JWT_SECRET_KEY=change-me-too
GEMINI_API_KEY=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
# --- Frontend (public values only; never put secrets in VITE_ vars) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AI_CHAT_ENABLED=true
# --- Optional ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LLM_TIMEOUT=15
SECURE_SSL=false          # set true in production behind HTTPS
LOG_LEVEL=INFO
PAYMENT_WEBHOOK_SECRET=
EMBEDDING_PROVIDER=hash     # hash (local, free) or gemini (needs GEMINI_API_KEY); run `manage.py reindex_all` after changing
NUM_PROXIES=1              # reverse proxies in front of the API (Render = 1); set 0 when running without a proxy
